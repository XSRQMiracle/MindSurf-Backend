# Paths below are inside the container. Host paths are configured separately
# through the Compose variables documented in docs/deployment.md.
MINDSURF_ENGINE=cascade
MINDSURF_DEVICE=cuda
MINDSURF_WEIGHTS=/models/release
MINDSURF_THINKER=/models/release/sft_merge_768.pth
MINDSURF_TOKENIZER=/models/release/tokenizer
MINIMIND_O_ROOT=/models/minimind-o
MINDSURF_ASR=/models/release/SenseVoiceSmall
MINDSURF_CODEC=/models/release/mimi
MINDSURF_SPEAKER=/models/release/campplus

# voxcpm stays local and needs the GPU. Use edge only if sending reply text to
# the hosted Edge TTS service is acceptable.
MINDSURF_TTS=voxcpm

MINDSURF_BACKEND_ENVIRONMENT=production
MINDSURF_BACKEND_VOICE_WS_PATH=/v1/voice/ws
