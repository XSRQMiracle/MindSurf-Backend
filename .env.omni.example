MINDSURF_ENGINE=cascade
MINDSURF_DEVICE=cuda

MINDSURF_WEIGHTS=/absolute/path/to/mindsurf-omni
MINDSURF_THINKER=/absolute/path/to/mindsurf-omni/sft_merge_768.pth
MINDSURF_TOKENIZER=/absolute/path/to/mindsurf-omni/tokenizer

MINIMIND_O_ROOT=/absolute/path/to/minimind-o
MINDSURF_ASR=/absolute/path/to/minimind-o/model/SenseVoiceSmall
MINDSURF_CODEC=/absolute/path/to/minimind-o/model/mimi
MINDSURF_SPEAKER=/absolute/path/to/minimind-o/model/campplus

MINDSURF_TTS=edge